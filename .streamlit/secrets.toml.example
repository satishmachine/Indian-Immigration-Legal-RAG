# Streamlit Community Cloud Secrets Template
# Copy the contents below and paste them into your Streamlit Cloud App Settings -> Secrets.

GROQ_API_KEY = "your_groq_api_key_here"
VOYAGE_API_KEY = "your_voyage_api_key_here"
OPENAI_API_KEY = "your_openai_api_key_here"

# Vector Store Settings (Default embedded local mode)
QDRANT__LOCATION = ":memory:"
