# =============================================================================
# Indian Immigration & Emigration Legal Assistant
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is listed in .gitignore.
#
# Naming convention mirrors the Pydantic Settings classes in:
#   src/core/config/settings.py
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Indian Immigration Legal Assistant"
APP_ENV=development                # development | staging | production
APP_VERSION=0.1.0
DEBUG=true

# ---------------------------------------------------------------------------
# Active LLM Provider
# Which provider is used by default when provider-agnostic code runs.
# Options: openai | anthropic | google | groq | ollama
# ---------------------------------------------------------------------------
ACTIVE_LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                 # console | json
LOG_DIR=logs                       # Relative or absolute path
LOG_MAX_BYTES=10485760             # 10 MB
LOG_BACKUP_COUNT=5
LOG_SQL_ECHO=false                 # Set true to echo SQLAlchemy queries

# ---------------------------------------------------------------------------
# API Server (FastAPI / Uvicorn)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_WORKERS=1                      # Set to CPU count in production
API_RELOAD=true                    # Must be false in production
API_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
API_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_AT_LEAST_32_CHARS
API_REQUEST_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60             # Requests per window
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# LLM Provider — OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_ORG_ID=                     # Optional organisation ID
OPENAI_BASE_URL=                   # Optional: override for Azure / proxies
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.0             # 0 for deterministic legal answers
OPENAI_REQUEST_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# LLM Provider — Anthropic (Claude)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
ANTHROPIC_BASE_URL=                # Optional: override for proxies
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_REQUEST_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# LLM Provider — Google Gemini
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GOOGLE_CHAT_MODEL=gemini-1.5-flash
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
GOOGLE_MAX_TOKENS=4096
GOOGLE_TEMPERATURE=0.0
GOOGLE_REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------------
# LLM Provider — Groq (ultra-fast inference)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.0
GROQ_REQUEST_TIMEOUT=30
GROQ_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# LLM Provider — Ollama (local inference)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.0
OLLAMA_REQUEST_TIMEOUT=120         # Ollama can be slow on CPU
OLLAMA_KEEP_ALIVE=5m               # How long to keep model loaded in memory

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Vector Database — Qdrant (Local / Qdrant Cloud)
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=                        # e.g. https://xyz.cloud.qdrant.io:6333 for Qdrant Cloud
QDRANT_API_KEY=                    # Leave empty for local; set for Qdrant Cloud
QDRANT_HTTPS=false                 # Set true for Qdrant Cloud / production
QDRANT_COLLECTION_NAME=legal_documents
QDRANT_VECTOR_SIZE=1536            # Must match embedding model output dimension (1536 for text-embedding-ada-002)
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Embedding Configuration
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=bge              # bge | sentence_transformers | openai | voyage | jina | ollama
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu               # cpu | cuda | mps
EMBEDDING_NORMALIZE=true

# ---------------------------------------------------------------------------
# Retrieval Configuration
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K_DENSE=20           # Candidates from dense (semantic) retrieval
RETRIEVAL_TOP_K_SPARSE=20          # Candidates from sparse (BM25) retrieval
RETRIEVAL_TOP_K_RERANK=5           # Final results after reranking
RETRIEVAL_SCORE_THRESHOLD=0.3      # Minimum similarity score (drop below this)
HYBRID_ALPHA=0.5                   # 0.0=sparse only  1.0=dense only

# ---------------------------------------------------------------------------
# Reranker (Cross-Encoder / FlashRank)
# ---------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_MAX_LENGTH=512

# ---------------------------------------------------------------------------
# Document Ingestion & Chunking
# ---------------------------------------------------------------------------
INGESTION_CHUNK_SIZE=1000          # Target chunk size in characters
INGESTION_CHUNK_OVERLAP=200        # Overlap between consecutive chunks
INGESTION_BATCH_SIZE=50            # Chunks per embed/upsert batch

# ---------------------------------------------------------------------------
# File-System Directories
# Paths may be relative (to project root) or absolute.
# ---------------------------------------------------------------------------
DOCUMENT_DIR=Data_Set              # Raw legal document corpus
UPLOAD_DIR=uploads                 # Temporary user-uploaded files
EVALUATION_DIR=evaluation          # RAGAS datasets, runners, reports
PROCESSED_DIR=processed            # Post-ingestion processed documents

# ---------------------------------------------------------------------------
# Streamlit Frontend
# ---------------------------------------------------------------------------
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark               # dark | light
STREAMLIT_PAGE_TITLE="Indian Immigration Legal Assistant"
STREAMLIT_PAGE_ICON=⚖️
STREAMLIT_MAX_UPLOAD_SIZE_MB=50
STREAMLIT_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
CACHE_BACKEND=disk                 # disk | redis | none
CACHE_TTL_SECONDS=3600             # 1 hour  (0 = no expiry)
CACHE_MAX_SIZE_MB=512
REDIS_URL=redis://localhost:6379/0 # Only used when CACHE_BACKEND=redis

# ---------------------------------------------------------------------------
# LangSmith — Tracing & Observability
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=YOUR_LANGSMITH_API_KEY
LANGCHAIN_PROJECT=indian-immigration-legal-assistant
